<%= turbo_frame_tag user do %>
  <%= form_with url: user_diag_chg_path(user), method: :post, scope: :user, data: { turbo_frame: dom_id(user) } do |f| %>
    <div class="row row-item align-items-center">
      <div class="col-sm-4"><strong><%= user.name %></strong> (<%= user.email %>)</div>

      <div class="col-sm-3">
        <div class="mb-1">
          <%= f.password_field :password, placeholder: "New password", class: "form-control form-control-sm" %>
        </div>
      </div>

      <div class="col-sm-3">
        <div class="mb-1">
          <%= f.password_field :password_confirmation, placeholder: "Confirm password", class: "form-control form-control-sm" %>
        </div>
      </div>

      <div class="col-sm-2">
        <div class="btn-group" role="group">
          <%= hidden_field_tag 'commands[]', 'user_pw' %>
          <%= f.submit "Set Password", class: "btn btn-primary btn-sm" %>
          <%= link_to "Cancel", user_row_path(user), data: { turbo_frame: dom_id(user) }, class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>

  <% if user.errors.any? %>
    <div class="mt-2">
      <% if user.errors[:password].any? %>
        <% user.errors[:password].uniq.each do |msg| %>
          <div class="text-danger"><%= msg %></div>
        <% end %>
      <% elsif user.errors[:password_confirmation].any? %>
        <% user.errors[:password_confirmation].uniq.each do |msg| %>
          <% if msg =~ /match/i || msg =~ /doesn'?t match/i %>
            <div class="text-danger">Password and confirmation must match</div>
          <% else %>
            <div class="text-danger"><%= msg %></div>
          <% end %>
        <% end %>
      <% else %>
        <% user.errors.full_messages.each do |msg| %>
          <div class="text-danger"><%= msg %></div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
